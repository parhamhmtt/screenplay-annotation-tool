<View>
  <Header value="Scene description / accessibility record"/>
  <Text name="film" value="$film_title"/>
  <Text name="time" value="$timecode"/>
  <Text name="context" value="$context_fa"/>
  <Header value="توصیف فارسی صحنه یا صدای مهم"/>
  <TextArea name="description_fa" toName="context" required="true" rows="4"/>
  <Header value="English description"/>
  <TextArea name="description_en" toName="context" required="true" rows="4"/>
  <Header value="Why the description is needed"/>
  <TextArea name="description_rationale" toName="context" required="true" rows="3"/>
  <Choices name="description_kind" toName="context" choice="single" required="true">
    <Choice value="Visual action"/><Choice value="Scene setting"/><Choice value="Sound cue"/><Choice value="Speaker identification"/>
  </Choices>
</View>
